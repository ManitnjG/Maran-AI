MARAN_DB_PATH=maran.db
MARAN_MODEL_ORDER=
MARAN_OPENCODE_ENABLED=false
MARAN_MAX_PARALLEL_WORKERS=6
MARAN_WORKER_TIMEOUT_SECONDS=120
# Provider API keys belong in deployment secrets, never source control.

MARAN_MAX_WORKER_RETRIES=2
MARAN_MAX_AGENTS_PER_MISSION=24

# Example OpenAI-compatible provider alias configuration:
# MARAN_MODEL_ORDER=primary,backup
# MARAN_PROVIDER_PRIMARY_URL=https://provider.example/v1
# MARAN_PROVIDER_PRIMARY_MODEL=model-name
# MARAN_PROVIDER_PRIMARY_API_KEY=set-in-secret-store
# Repeat MARAN_PROVIDER_<ALIAS>_* for fallback providers.

# OpenCode Zen AI gateway
OPENCODE_API_KEY=
MARAN_OPENCODE_ZEN_MODEL=big-pickle
