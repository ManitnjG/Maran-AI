{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MaranAgent",
  "type": "object",
  "required": [
    "id",
    "name",
    "role",
    "permissions"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "temporary": {
      "type": "boolean",
      "default": false
    }
  },
  "additionalProperties": true
}