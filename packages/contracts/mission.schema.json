{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MaranMission",
  "type": "object",
  "required": [
    "id",
    "objective",
    "status",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "queued",
        "planning",
        "running",
        "waiting_approval",
        "verifying",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "workspaceId": {
      "type": "string"
    },
    "assignedAgents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "enum": [
        "pending",
        "verified",
        "partial",
        "conflicting",
        "unverified"
      ]
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}