{
  "$defs": {
    "MissionStatus": {
      "enum": [
        "queued",
        "planning",
        "running",
        "waiting_approval",
        "verifying",
        "blocked",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "MissionStatus",
      "type": "string"
    },
    "PlanStep": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "requires_approval": {
          "default": false,
          "title": "Requires Approval",
          "type": "boolean"
        },
        "status": {
          "default": "pending",
          "title": "Status",
          "type": "string"
        },
        "approved": {
          "default": false,
          "title": "Approved",
          "type": "boolean"
        },
        "output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "id",
        "title",
        "agent"
      ],
      "title": "PlanStep",
      "type": "object"
    },
    "Verification": {
      "enum": [
        "pending",
        "verified",
        "partial",
        "conflicting",
        "unverified"
      ],
      "title": "Verification",
      "type": "string"
    }
  },
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "objective": {
      "title": "Objective",
      "type": "string"
    },
    "workspace_id": {
      "default": "default",
      "title": "Workspace Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/MissionStatus",
      "default": "queued"
    },
    "verification": {
      "$ref": "#/$defs/Verification",
      "default": "pending"
    },
    "assigned_agents": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Assigned Agents",
      "type": "array"
    },
    "plan": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PlanStep"
      },
      "title": "Plan",
      "type": "array"
    },
    "events": {
      "default": [],
      "items": {
        "type": "object"
      },
      "title": "Events",
      "type": "array"
    },
    "result": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "objective"
  ],
  "title": "Mission",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
