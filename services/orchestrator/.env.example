MARAN_DB_PATH=maran.db
# All reasoning uses OpenCode Zen. Blank key does not guarantee free-tier access.
OPENCODE_API_KEY=
# Blank selects active free models automatically; paid/unknown prices are rejected.
MARAN_OPENCODE_ZEN_MODEL=
# Set a long random token before exposing the API. Android requires HTTPS for tokens.
MARAN_ACCESS_TOKEN=
MARAN_ENV=development
MARAN_STORAGE_MODE=local_sqlite
MARAN_WEB_ENABLED=true
# Optional Exa key; blank uses the documented keyless rate-limited service.
EXA_API_KEY=


# --- Optional external action connectors (Maran 0.8) ---
# Google OAuth access token with only the scopes you intend to use.
GOOGLE_ACCESS_TOKEN=
# GitHub fine-grained token and default repository (owner/repo).
GITHUB_TOKEN=
GITHUB_REPOSITORY=
# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta publishing/analytics
META_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_USER_ID=
# LinkedIn
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
# Twilio SMS / voice
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Tally XML/HTTP endpoint reachable from the orchestrator.
TALLY_URL=
