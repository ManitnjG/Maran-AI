MARAN_DB_PATH=maran.db
# Comma-separated configured providers. Keys belong in deployment secrets, never source control.
MARAN_MODEL_ORDER=
MARAN_OPENCODE_ENABLED=false

# Set a long random token before exposing the API. Android requires HTTPS for tokens.
MARAN_ACCESS_TOKEN=
# Optional local/server-hosted model; no paid API key required.
# Install/pull the selected model on that server separately.
MARAN_OLLAMA_URL=
MARAN_OLLAMA_MODEL=qwen2.5:3b

MARAN_ENV=development
MARAN_STORAGE_MODE=local_sqlite
MARAN_WEB_ENABLED=true
# Optional Exa key; blank uses the documented keyless rate-limited service.
EXA_API_KEY=
# Optional CLI adapter. Install opencode-ai@1.18.33 first; free access is not guaranteed.
MARAN_OPENCODE_FREE_ENABLED=false
MARAN_OPENCODE_FREE_MODELS=opencode/big-pickle,opencode/mimo-v2.6-flash-free
