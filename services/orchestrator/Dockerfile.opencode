# Optional text-only OpenCode provider. Free access is provider-controlled and may be unavailable.
FROM node:22-bookworm-slim AS cli
RUN npm install -g opencode-ai@1.18.33
FROM python:3.12-slim-bookworm
COPY --from=cli /usr/local/bin/node /usr/local/bin/node
COPY --from=cli /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/opencode-ai/bin/opencode /usr/local/bin/opencode
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && useradd --create-home --uid 10001 maran \
    && mkdir /data && chown maran:maran /data
COPY --chown=maran:maran app ./app
ENV MARAN_DB_PATH=/data/maran.db
USER maran
EXPOSE 8000
CMD ["python","-m","uvicorn","app.main:app","--host","0.0.0.0","--port","8000","--workers","1"]
